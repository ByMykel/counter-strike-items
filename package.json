{
  "name": "counter-strike-items",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix src",
    "prettier": "prettier src --check --write",
    "format": "npm run prettier && npm run lint",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@csfloat/cs2-inspect-serializer": "^1.1.6",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.18.1",
    "fuse.js": "^7.5.0",
    "lodash.uniqby": "^4.7.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/lodash.uniqby": "^4.7.9",
